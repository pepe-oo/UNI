boolean DFS(v,color)
{
    v.setColor(color);
    v.setVisited();
    for u vecino de v
    {
        if (u.getVisited() == true)
        {
            if (u.getColor() == color)
            {
                return true
            }
        }
        else if (DFS(u, 3- color) == true)
        {
            return true
        }
        endif
    }
    endfor
    return false
}

boolean HasOddCycle(G(V,E))
{
    for v in G.V()
    {
        if (v.getVisited() == false)
            if (DFS(v,1) == true)
                return true
    }
    return false
}


void WheelColoring(G(V,E))
{
    Vertex centro = null
    int maxGrado = 0
    for v in G.V()
    {
        if δ(v) > maxGrado
        {
            centro = v
            v.setColor(1)
            maxGrado = δ(v)
        }
    }
    if δ(centro)%2 == 0
    {
        color = 2
        for u vecino de centro
            u.setColor(color)
            color = 5 - color
    }
    else 
    {
        color = 2
        vertex ultimo = null
        for u vecino de centro
            u.setColor(color)
            color = 5 - color
            ultimo = u
        ultimo.setColor(4)
    }
}

